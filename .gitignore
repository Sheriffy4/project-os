node_modules/
backups/
data/
local/

# Local project data (vaults, uploads, exports) is intentionally not committed.
projects/*
!projects/.gitkeep
exports/

# Local game source created by agents; not part of the tracker repo.
/emulator/
/.opencode/
/projects.7z
/tmp_*.py

# Game-specific / local-only seed and migration files.
# The reusable tracker works with an empty database and the new-project wizard.
/seed.mjs
/lib/seed-data.mjs
/lib/extra-ideas.mjs
/scripts/*
!/scripts/backup-db.mjs
!/scripts/cleanup-uploads.mjs
!/scripts/backfill-status-history.mjs

*.log
.env
*.db
*.db-wal
*.db-shm
.DS_Store
Thumbs.db

projects/*/vault/.obsidian/workspace*
projects/*/vault/.obsidian/cache
